{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["src/App.tsx", "src/main.tsx"]
}
