{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "audit": "tsx src/cli.ts",
    "audit:ci": "tsx src/cli.ts --ci",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pretest": "node -e \"require('fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "demo": "python demo_gdg_jakarta.py",
    "demo:auto": "python demo_gdg_jakarta.py --auto",
    "video:preview": "remotion studio remotion/index.ts",
    "video:render:60s": "remotion render remotion/index.ts DevGuard60sShowcase out/devguard-60s-judge-showcase.mp4 --codec=h264 --timeout=180000 --image-format=jpeg",
    "video:render": "remotion render remotion/index.ts DevGuardRetimedVideo out/devguard-demo-3min.mp4 --codec=h264 --timeout=180000 --image-format=jpeg",
    "video:render:full": "remotion render remotion/index.ts DevGuardFullDemo out/devguard-programmatic-demo-60fps.mp4 --codec=h264"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@remotion/cli": "^4.0.540",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.540",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
